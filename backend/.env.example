DATABASE_URL=jdbc:postgresql://localhost:5432/surgam
DATABASE_USERNAME=replace-locally
DATABASE_PASSWORD=replace-locally
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Generate independent random secrets of at least 32 bytes and base64-encode them.
JWT_HMAC_SECRET=
OTP_HMAC_SECRET=
# Generate independent values: PAN_HMAC_SECRET is 32+ random bytes encoded as Base64;
# PAN_ENCRYPTION_KEY is exactly 32 random bytes encoded as Base64.
PAN_HMAC_SECRET=
PAN_ENCRYPTION_KEY=
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=surgam-investor-app
